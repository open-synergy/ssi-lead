<odoo>
<record id="crm_lead_access_all" model="ir.model.access">
    <field name="name">crm_lead - all</field>
    <field name="model_id" ref="model_crm_lead" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
</record>

<record id="crm_lead_access_user" model="ir.model.access">
    <field name="name">crm_lead - user</field>
    <field name="model_id" ref="model_crm_lead" />
    <field name="group_id" ref="crm_lead_user_group" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
</record>

<record id="crm.access_crm_lead_manager" model="ir.model.access">
    <field name="active" eval="False" />
</record>

<record id="crm.access_crm_lead_partner_manager" model="ir.model.access">
    <field name="active" eval="False" />
</record>

<record id="crm.access_crm_lead" model="ir.model.access">
    <field name="active" eval="False" />
</record>
</odoo>
