<odoo>
<record id="crm_lead_viewer_group" model="res.groups">
    <field name="name">Viewer</field>
    <field name="category_id" ref="crm_lead_module_category_workflow" />
</record>

<record id="crm_lead_user_group" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="crm_lead_module_category_workflow" />
    <field name="implied_ids" eval="[(4, ref('crm_lead_viewer_group'))]" />
</record>

<record id="crm_lead_validator_group" model="res.groups">
    <field name="name">Validator</field>
    <field name="category_id" ref="crm_lead_module_category_workflow" />
    <field name="implied_ids" eval="[(4, ref('crm_lead_user_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

<record id="crm_lead_leader_group" model="res.groups">
    <field name="name">Team</field>
    <field name="category_id" ref="crm_lead_module_category_data_ownership" />
</record>

<record id="crm_lead_company_group" model="res.groups">
    <field name="name">Company</field>
    <field name="category_id" ref="crm_lead_module_category_data_ownership" />
    <field name="implied_ids" eval="[(4, ref('crm_lead_leader_group'))]" />
</record>

<record id="crm_lead_child_company_group" model="res.groups">
    <field name="name">Company and All Child Companies</field>
    <field name="category_id" ref="crm_lead_module_category_data_ownership" />
    <field name="implied_ids" eval="[(4, ref('crm_lead_company_group'))]" />
</record>

<record id="crm_lead_all_group" model="res.groups">
    <field name="name">All</field>
    <field name="category_id" ref="crm_lead_module_category_data_ownership" />
    <field name="implied_ids" eval="[(4, ref('crm_lead_company_group'))]" />
</record>
</odoo>
