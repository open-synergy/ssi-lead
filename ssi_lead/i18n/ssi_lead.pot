#. module: ssi_lead
#: code:addons/ssi_lead/models/crm_team_member_role.py:0
#, python-format
msgid ""
"\n"
"Context: Assign users to a sales team role\n"
"Database ID: %s\n"
"Problem: One or more users are not members of sales team \"%s\".\n"
"Solution: Only assign users who are members of the team (tab Members).\n"
msgstr ""

#. module: ssi_lead
#: code:addons/ssi_lead/models/crm_lead.py:0
#, python-format
msgid ""
"\n"
"Context: Change Opportunity Stage\n"
"Database ID: %s\n"
"Problem: Moving a lead of sales team \"%s\" from stage \"%s\" to stage \"%s\" is\n"
"restricted to role(s): %s. User \"%s\" holds none of those roles in this team.\n"
"Solution: Ask a user with one of the required roles to move the stage, or\n"
"update Member Roles / Stage Restrictions of sales team \"%s\".\n"
msgstr ""

#. module: ssi_lead
#: code:addons/ssi_lead/models/crm_team_stage_restriction.py:0
#, python-format
msgid ""
"\n"
"Context: Configure sales team stage restriction\n"
"Database ID: %s\n"
"Problem: Both \"From Stage\" and \"To Stage\" are empty.\n"
"Solution: Fill in at least one of \"From Stage\" or \"To Stage\".\n"
msgstr ""

#. module: ssi_lead
#: code:addons/ssi_lead/models/crm_team_stage_restriction.py:0
#, python-format
msgid ""
"\n"
"Context: Configure sales team stage restriction\n"
"Database ID: %s\n"
"Problem: No allowed role is set on this stage restriction.\n"
"Solution: Add at least one role under \"Allowed Roles\".\n"
msgstr ""

